[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="character"
3d_physics/layer_3="debris"
3d_physics/layer_4="query"

[physics]

3d/default_gravity=196.2
3d/default_gravity_vector=Vector3(0, -1, 0)
3d/physics_engine="DEFAULT"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
textures/default_filters/anisotropic_filtering_level=0
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=0
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/size=2048
environment/defaults/default_clear_color=Color(0.043, 0.055, 0.078, 1)
environment/defaults/default_environment="res://data/default_environment.tres"
