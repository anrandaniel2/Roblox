#!/usr/bin/env python
"""Builds the Luau GDExtension.

Run from this directory after `python3 tools/fetch_deps.py`:

    scons platform=linux arch=x86_64 target=template_release api_version=4.7

The environment (platform flags, `target`, `arch`, output suffix) comes from
godot-cpp's own SConstruct, which is included below; Luau's sources are then
compiled straight into the extension so there is no runtime dependency to ship.
"""
import os

env = SConscript("extern/godot-cpp/SConstruct")

# Luau signals parse and compile errors by throwing C++ exceptions, and
# godot-cpp compiles with exceptions disabled. Re-enable them for this target;
# the flag is appended after godot-cpp's own, and the last one wins.
if env["platform"] == "windows":
	env.Append(CCFLAGS=["/EHsc"], CXXFLAGS=["/EHsc"])
else:
	env.Append(CCFLAGS=["-fexceptions"], CXXFLAGS=["-fexceptions"])

luau_root = os.path.join("extern", "luau")

# Every component of Luau exposes its headers under `<component>/include`, and
# they cross-reference each other (the Compiler pulls in Bytecode, for example),
# so add them all rather than guessing per source group.
for entry in sorted(os.listdir(luau_root)) if os.path.isdir(luau_root) else []:
    candidate = os.path.join(luau_root, entry, "include")
    if os.path.isdir(candidate):
        env.Append(CPPPATH=[candidate])

# Only what a runtime needs: parsing (Ast), bytecode generation (Compiler) and
# execution (VM). CodeGen/Analysis/Inliner are for native codegen, type checking
# and linting, none of which a game needs at run time.
luau_sources = []
for part in ("Common/src", "Ast/src", "Compiler/src", "VM/src"):
    luau_sources += Glob(os.path.join(luau_root, part, "*.cpp"))

env.Append(CPPPATH=["src"])
sources = Glob("src/*.cpp") + luau_sources

if not luau_sources:
    raise SCons.Errors.UserError(
        "Luau sources not found under %s — run `python3 tools/fetch_deps.py` first." % luau_root
    )

if env["platform"] == "macos":
    library = env.SharedLibrary(
        "bin/libluau_vm{}.framework/libluau_vm{}".format(env["suffix"], env["suffix"]),
        source=sources,
    )
else:
    library = env.SharedLibrary("bin/libluau_vm{}{}".format(env["suffix"], env["SHLIBSUFFIX"]), source=sources)

env.NoCache(library)
Default(library)
