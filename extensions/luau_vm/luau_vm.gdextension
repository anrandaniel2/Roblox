[configuration]

entry_symbol = "luau_vm_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://extensions/luau_vm/bin/libluau_vm.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://extensions/luau_vm/bin/libluau_vm.linux.template_release.x86_64.so"

windows.debug.x86_64 = "res://extensions/luau_vm/bin/libluau_vm.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://extensions/luau_vm/bin/libluau_vm.windows.template_release.x86_64.dll"

macos.debug = "res://extensions/luau_vm/bin/libluau_vm.macos.template_debug.universal.dylib"
macos.release = "res://extensions/luau_vm/bin/libluau_vm.macos.template_release.universal.dylib"

android.debug.arm64 = "res://extensions/luau_vm/bin/libluau_vm.android.template_debug.arm64.so"
android.release.arm64 = "res://extensions/luau_vm/bin/libluau_vm.android.template_release.arm64.so"
android.debug.arm32 = "res://extensions/luau_vm/bin/libluau_vm.android.template_debug.arm32.so"
android.release.arm32 = "res://extensions/luau_vm/bin/libluau_vm.android.template_release.arm32.so"
